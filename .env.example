# ==============================================================================
# ReliefAI Backend - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and update the values to match your local or production environment.
# Never commit '.env' containing active credentials to version control.
# ==============================================================================

# Core Application Settings
NODE_ENV=development               # Options: development | staging | production
NODE_DB_ENV=development            # Database environment mode
PORT=5001                          # Port on which the NestJS HTTP server listens
FRONTEND_URL=http://localhost:3000 # Client URL allowed for CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Authentication & JWT Configuration
# Generate 64-character hex strings: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_BEARER_SECRET=your_jwt_access_secret_key_here_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_min_32_chars
JWT_TTL=86400                      # Access token validity in seconds (e.g., 86400 = 24h)
JWT_REFRESH_TTL=604800             # Refresh token validity in seconds (e.g., 604800 = 7 days)

# Database Configuration (PostgreSQL)
DB_CLIENT=postgres
DATABASE_URL=                          # Optional on local, recommended on Render/Cloud (e.g., postgresql://user:pwd@host:5432/dbname)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password
DB_DATABASE=reliefe
DB_SSL=false                           # Set to true for Render/cloud managed PostgreSQL requiring SSL
DB_SYNCHRONIZE=false                   # Auto sync schema: defaults to 'false' in production for safety; 'true' in development

# Redis Configuration (Optional: background queues & token blacklist)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=                         # Leave blank if Redis is not used locally (e.g., redis://localhost:6379)

# Email Server Configuration (SMTP for notification dispatch)
MAILER_HOST=smtp.mailtrap.io
MAILER_PORT=587
MAILER_SECURE=false
MAILER_USER=your_smtp_username
MAILER_PASSWORD=your_smtp_password
MAILER_FROM="ReliefAI Emergency Alerts <no-reply@relief.ai>"
# Demo data is opt-in for development only and is always disabled in production.
SEED_DEMO_DATA=false
# JWT_ACCESS_SECRET may be used instead of legacy JWT_BEARER_SECRET.
# Match JWT_ACCESS_SECRET and JWT_REFRESH_SECRET on the frontend server.
